# TemeCMS for Dokploy: every variable the stack reads.
# On Dokploy these live in the service's Environment tab, not in a file.
# This file is a list for you to read; it holds no real values.
# Pinned Teme release: 0.8.0-alpha.1 (teme-pin)

# ---------------------------------------------------------------------------
# 1. MADE BY THE PANEL when you deploy the template (template.toml). Do not
#    retype them. Never change APP_KEY after the first deploy.
# ---------------------------------------------------------------------------
# The Teme image with its exact release, never "latest".
TEME_IMAGE=
# The same image, for the updater. Must always be set.
TEME_UPDATER_IMAGE=
# The image without its tag. The updater builds image names from it.
TEME_IMAGE_REPOSITORY=
# The site's address, with https. Teme refuses requests for any other host.
APP_URL=
# The key that encrypts what Teme stores: "base64:" and 32 random bytes in base64.
APP_KEY=
# The password of Teme's own database login.
DB_PASSWORD=
# The password of the database administrator.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# 2. TYPED BY YOU, when you want the Update button (README: "Switching on the
#    Update button"). The template leaves them empty on purpose.
# ---------------------------------------------------------------------------
# The panel's address. The template sets http://dokploy:3000.
TEME_DOKPLOY_URL=
# The service's id, from its address in the panel after /services/compose/.
TEME_DOKPLOY_COMPOSE_ID=
# A Dokploy API key. It can act as you in the panel: keep it to this one service.
TEME_DOKPLOY_TOKEN=
# Optional. Teme's releases are public; a GitHub token only raises GitHub's
# limit on requests when the site checks for new releases.
TEME_GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# 3. OPTIONAL. Leave out unless you need them. Each reaches every Teme
#    service. Teme's own guide (docs/guides/operators/configure.md) lists them all.
# ---------------------------------------------------------------------------
# Size limits. The defaults suit one site; a host cannot give out more memory than it has.
# TEME_WEB_CPUS=1
# TEME_WEB_MEMORY=1g
# TEME_WORKER_CPUS=0.5
# TEME_WORKER_MEMORY=512m

# Mail. Without it Teme cannot send; its doctor warns.
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME=
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME=

# The proxies whose X-Forwarded headers Teme believes (behind Cloudflare: private,cloudflare).
# TRUSTED_PROXIES=
# Which releases the update check offers.
# TEME_UPDATES_CHANNEL=
# Backups are off until you set them up in Tools > Backups. A key the schedule
# can use without a person: see Teme's backup guide before setting it.
# TEME_BACKUP_MACHINE_KEY=
# A host that forbids AI sets this to off.
# TEME_AI=on
